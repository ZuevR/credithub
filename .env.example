# Скопируйте в .env и при необходимости поправьте.
# Порт 5433 - см. комментарий в docker-compose.yml.

# core-api: подключение к PostgreSQL
DATABASE_URL=postgres://credithub:credithub@localhost:5433/credithub

# bff: куда ходить за данными. Включает префикс core-api (/api) -
# именно из-за его отсутствия BFF получал 404 на каждом запросе.
CORE_API_URL=http://localhost:3001/api

# Порты сервисов
CORE_API_PORT=3001
BFF_PORT=3000
