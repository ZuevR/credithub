# Скопируйте в .env и при необходимости поправьте.
# Порт 5433 - см. комментарий в docker-compose.yml.

# core-api: подключение к PostgreSQL
DATABASE_URL=postgres://credithub:credithub@localhost:5433/credithub

# bff: куда ходить за данными. Включает префикс core-api (/api) -
# именно из-за его отсутствия BFF получал 404 на каждом запросе.
CORE_API_URL=http://localhost:3001/api

# Порты сервисов.
# Внимание: имя BFF_HTTP_PORT, а не BFF_PORT - Kubernetes сам создаёт
# переменную <ИМЯ_СЕРВИСА>_PORT для сервиса `bff`, и совпадение имён ломает
# разбор порта (подробности в PROGRESS.md).
CORE_API_PORT=3001
BFF_HTTP_PORT=3000

# bff: проверка токенов Keycloak. Без KC_ISSUER процесс падает на старте - так
# задумано: без issuer проверить токен невозможно, и упасть сразу честнее, чем
# молча отвергать все запросы.
#
#   KC_ISSUER   - внешний адрес realm'а. Он проверяется в самом токене (claim
#                 `iss`), поэтому должен совпадать с тем, что видит браузер.
#   KC_JWKS_URI - необязательный отдельный адрес ключей. Нужен, когда issuer
#                 доступен только по https с самоподписанным сертификатом: Node
#                 такой сертификат не примет, поэтому ключи берут по адресу,
#                 который машина реально видит (в кластере или через port-forward).
#
# Пример локальной разработки против офисного стенда:
#   kubectl -n credithub port-forward svc/keycloak 8080:8080
#   KC_ISSUER=https://192.168.1.187/auth/realms/credithub
#   KC_JWKS_URI=http://localhost:8080/auth/realms/credithub/protocol/openid-connect/certs
KC_ISSUER=
KC_JWKS_URI=
