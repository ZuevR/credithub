# Контекст сборки Docker - корень репозитория, поэтому исключаем всё тяжёлое и
# лишнее. Без этого в контекст уехали бы node_modules (мегабайты на каждый
# билд) и история git.

# Зависимости внутри образа ставятся заново - локальные не нужны и, что важнее,
# собраны под другую платформу (arm64 против linux/amd64).
node_modules
**/node_modules

# Результаты сборки: их создаёт сам образ.
dist
**/dist
.nx

# Кэши и артефакты инструментов
.cache
.vite
coverage
# Кэш сборки Angular: локально разрастается до сотен мегабайт и в контекст
# сборки образа попадать не должен.
.angular
.nx/cache
tmp
*.tsbuildinfo
.mf
@mf-types
@mf-types.zip

# Локальные секреты - в образ им попадать незачем
.env
.env.*
!.env.example
infra/.env.infra
# Токен реестра. В публикуемый образ он не попадал и раньше (в рантайм-стадию
# копируются только dist/node_modules), но в контекст сборки и в кэш builder'а
# попадал бы - а токен уже один раз утекал, повторять не хочется.
infra/.ghcr-token
**/.ghcr-token

# Системный мусор
.git
.gitignore
.DS_Store
