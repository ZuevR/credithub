{
  "name": "core-api",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "sourceRoot": "apps/core-api/src",
  "projectType": "application",
  "tags": [],
  "targets": {
    "prune-lockfile": {
      "dependsOn": [
        "build"
      ],
      "cache": true,
      "executor": "@nx/js:prune-lockfile",
      "outputs": [
        "{workspaceRoot}/dist/apps/core-api/package.json",
        "{workspaceRoot}/dist/apps/core-api/yarn.lock"
      ],
      "options": {
        "buildTarget": "build"
      }
    },
    "copy-workspace-modules": {
      "dependsOn": [
        "build"
      ],
      "cache": true,
      "outputs": [
        "{workspaceRoot}/dist/apps/core-api/workspace_modules"
      ],
      "executor": "@nx/js:copy-workspace-modules",
      "options": {
        "buildTarget": "build"
      }
    },
    "prune": {
      "dependsOn": [
        "prune-lockfile",
        "copy-workspace-modules"
      ],
      "executor": "nx:noop"
    },
    "serve": {
      "continuous": true,
      "executor": "@nx/js:node",
      "defaultConfiguration": "development",
      "dependsOn": [
        "build"
      ],
      "options": {
        "buildTarget": "core-api:build",
        "runBuildTargetDependencies": false,
        "port": 3001,
        "inspect": false
      },
      "configurations": {
        "development": {
          "buildTarget": "core-api:build:development"
        },
        "production": {
          "buildTarget": "core-api:build:production"
        }
      }
    },
    "migration:generate": {
      "executor": "nx:run-commands",
      "options": {
        "command": "typeorm-ts-node-commonjs migration:generate apps/core-api/src/db/migrations/{args.name} -d apps/core-api/src/db/data-source.ts",
        "cwd": "{workspaceRoot}",
        "env": {
          "TS_NODE_PROJECT": "apps/core-api/tsconfig.app.json"
        }
      }
    },
    "migration:run": {
      "executor": "nx:run-commands",
      "options": {
        "command": "typeorm-ts-node-commonjs migration:run -d apps/core-api/src/db/data-source.ts",
        "cwd": "{workspaceRoot}",
        "env": {
          "TS_NODE_PROJECT": "apps/core-api/tsconfig.app.json"
        }
      }
    },
    "migration:revert": {
      "executor": "nx:run-commands",
      "options": {
        "command": "typeorm-ts-node-commonjs migration:revert -d apps/core-api/src/db/data-source.ts",
        "cwd": "{workspaceRoot}",
        "env": {
          "TS_NODE_PROJECT": "apps/core-api/tsconfig.app.json"
        }
      }
    },
    "migration:show": {
      "executor": "nx:run-commands",
      "options": {
        "command": "typeorm-ts-node-commonjs migration:show -d apps/core-api/src/db/data-source.ts",
        "cwd": "{workspaceRoot}",
        "env": {
          "TS_NODE_PROJECT": "apps/core-api/tsconfig.app.json"
        }
      }
    },
    "seed": {
      "executor": "nx:run-commands",
      "dependsOn": [
        "build"
      ],
      "options": {
        "command": "node dist/apps/core-api/seed.js",
        "cwd": "{workspaceRoot}"
      }
    }
  }
}
